{
  "expo": {
    "name": "Unlock PDF",
    "slug": "unlock-pdf-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/app-icon.png",
    "scheme": "unlockpdf",
    "userInterfaceStyle": "automatic",
    "platforms": [
      "ios"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.dlhyl.unlockpdf",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#3B6CF6",
          "ios": {
            "image": "./assets/images/splash-lock.png",
            "imageWidth": 96
          }
        }
      ],
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "4b7f6400-e960-41e7-9fc4-8e1427975ade"
      }
    },
    "owner": "dlhyl"
  }
}
